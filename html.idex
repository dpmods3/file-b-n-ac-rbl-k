<!DOCTYPE html>
<html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>VTACC - Shop tài khoản game</title>
<style>
:root{--bg:#080d18;--panel:#111e30;--line:#293d58;--blue:#238dff;--cyan:#39d5e8;--muted:#9aabc1}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:#f4f8ff;font:15px Arial,sans-serif}a{color:inherit;text-decoration:none}.wrap{width:min(1100px,calc(100% - 36px));margin:auto}header{height:68px;position:sticky;top:0;z-index:5;background:#080d18ed;border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}.nav{height:100%;display:flex;align-items:center;justify-content:space-between;gap:18px}.logo{font-size:23px;font-weight:900}.logo span,h1 span{color:var(--cyan)}nav{display:flex;gap:25px;color:#c5d2e4;font-size:14px}nav a:hover{color:var(--cyan)}button{cursor:pointer;font-weight:bold;border:0;border-radius:7px;padding:10px 14px}.btn{background:#172941;color:white;border:1px solid #344c6b}.mainbtn{background:linear-gradient(110deg,#167cf0,#27c6df);color:#061321}.hero{padding:68px 0;background:radial-gradient(ellipse at 80% 10%,#16416d,transparent 45%),linear-gradient(120deg,#0b1728,#09111e);border-bottom:1px solid #1b2d43}.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:35px;align-items:center}.kicker,.eyebrow{font-size:11px;letter-spacing:2px;color:var(--cyan);font-weight:800}h1{font-size:clamp(34px,5vw,51px);line-height:1.12;margin:14px 0}p{color:#aabbd0;line-height:1.6}.hero-art{min-height:220px;border:1px solid #2a4d70;border-radius:16px;padding:24px;background:linear-gradient(145deg,#173a60,#101c30);display:flex;flex-direction:column;justify-content:space-between}.art-icons{font-size:40px;letter-spacing:7px}.hero-art strong{font-size:21px}.hero-art small{color:#abc1d9}.hero-buttons{display:flex;gap:10px;margin-top:23px}.section{padding-top:46px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:18px;gap:10px}h2{font-size:24px;margin:5px 0}.sub{font-size:13px;color:var(--muted)}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.feature{background:linear-gradient(145deg,#14243a,#0f1929);border:1px solid var(--line);border-radius:10px;padding:17px}.feature .ico{font-size:24px}.feature h3{font-size:15px;margin:8px 0 4px}.feature p{font-size:12px;margin:0}.cats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.cat{background:#111e30;border:1px solid var(--line);border-radius:9px;padding:14px;text-align:left;color:white}.cat.active,.cat:hover{border-color:var(--cyan);background:#142b42}.cat span{font-size:24px}.cat b{display:block;font-size:13px;margin-top:6px}.cat small{color:var(--muted);font-size:11px}.search{display:flex;gap:8px;margin-bottom:14px}.search input{flex:1;min-width:0;padding:11px 13px;border-radius:8px;border:1px solid #314761;background:#101a2b;color:white}.products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.product{background:#111d2e;border:1px solid #263a54;border-radius:10px;overflow:hidden;transition:.2s}.product:hover{transform:translateY(-3px);border-color:#3c8bc2}.cover{height:100px;background:radial-gradient(circle at 50% 35%,#285982,#13243a 72%);display:grid;place-items:center;font-size:38px;position:relative}.status{position:absolute;top:8px;left:8px;background:#0d927f;padding:3px 6px;border-radius:4px;font-size:9px;font-weight:bold}.info{padding:11px}.info h3{font-size:12px;min-height:32px;line-height:1.4;margin:0 0 7px}.meta{display:flex;justify-content:space-between;color:var(--muted);font-size:10px;border-bottom:1px solid #293a50;padding-bottom:8px}.price{color:#ffcc65;font-weight:900;font-size:16px;margin:9px 0}.actions{display:flex;gap:6px}.actions button{flex:1;padding:8px 3px;font-size:10px}.detail{background:#233a57;color:white;border:1px solid #36516f}.buy{background:linear-gradient(110deg,#1685f5,#27bfd8);color:#041522}.notice{margin-top:13px;padding:11px;border:1px solid var(--line);border-radius:8px;color:var(--muted);font-size:11px}footer{margin-top:50px;padding:27px 0;border-top:1px solid var(--line);background:#0b1320;color:var(--muted);font-size:12px}.foot{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.modal{display:none;position:fixed;inset:0;z-index:10;background:#000c;align-items:center;justify-content:center;padding:16px}.modal.show{display:flex}.box{width:min(420px,100%);background:#111e30;border:1px solid #35516e;border-radius:13px;padding:20px}.mhead{display:flex;justify-content:space-between;align-items:center}.mhead h2{font-size:19px}.close{background:none;color:white;font-size:22px}.box p{font-size:13px}.cartrow{display:flex;justify-content:space-between;gap:8px;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px}
@media(max-width:760px){nav{display:none}.hero{padding:45px 0}.hero-grid{grid-template-columns:1fr}.hero-art{min-height:150px}.features{grid-template-columns:1fr}.products{grid-template-columns:repeat(2,minmax(0,1fr))}.cats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:420px){.wrap{width:calc(100% - 24px)}header{height:60px}.logo{font-size:19px}.nav .btn{font-size:11px;padding:8px}.section{padding-top:35px}.products{gap:9px}.cover{height:85px;font-size:32px}.info{padding:9px}.info h3{font-size:11px}.price{font-size:14px}.actions button{font-size:9px}}
</style></head><body>
<header><div class="wrap nav"><a class="logo" href="#home">VT<span>ACC.</span></a><nav><a href="#home">Trang chủ</a><a href="#features">Tính năng</a><a href="#categories">Danh mục</a><a href="#products">Sản phẩm</a></nav><button class="btn" onclick="showCart()">🛒 Giỏ hàng (<span id="count">0</span>)</button></div></header>
<section class="hero" id="home"><div class="wrap hero-grid"><div><div class="kicker">VTACC · GAME ACCOUNT STORE</div><h1>SHOP TÀI KHOẢN<br><span>GAME UY TÍN</span></h1><p>Khám phá kho tài khoản game với nhiều lựa chọn. Chọn danh mục yêu thích, xem thông tin và tìm tài khoản phù hợp ngay tại đây.</p><div class="hero-buttons"><a class="btn mainbtn" href="#products">XEM SẢN PHẨM</a><a class="btn" href="#features">TÌM HIỂU THÊM</a></div></div><div class="hero-art"><div class="art-icons">🎮 ⚔️ 💎</div><div><strong>YOUR GAME. YOUR STYLE.</strong><br><small>Không gian trưng bày tài khoản game</small></div></div></div></section>
<main class="wrap">
<section class="section" id="features"><div class="section-head"><div><div class="eyebrow">ĐIỂM NỔI BẬT</div><h2>Tính năng cửa hàng</h2><p class="sub">Thiết kế đơn giản, thao tác nhanh chóng</p></div></div><div class="features"><article class="feature"><div class="ico">🛡️</div><h3>Thông tin minh bạch</h3><p>Mỗi sản phẩm có mã riêng, giá bán và mô tả rõ ràng.</p></article><article class="feature"><div class="ico">⚡</div><h3>Tìm kiếm nhanh</h3><p>Lọc tài khoản theo danh mục hoặc mã sản phẩm.</p></article><article class="feature"><div class="ico">💬</div><h3>Hỗ trợ khách hàng</h3><p>Khu vực liên hệ có thể cập nhật theo thông tin shop.</p></article></div></section>
<section class="section" id="categories"><div class="section-head"><div><div class="eyebrow">CHỌN GAME</div><h2>Danh mục tài khoản</h2><p class="sub">Chọn một danh mục để xem acc trưng bày</p></div></div><div class="cats" id="cats"></div></section>
<section class="section" id="products"><div class="section-head"><div><div class="eyebrow">KHO TÀI KHOẢN</div><h2 id="heading">Acc đang trưng bày</h2><p class="sub">Danh sách sản phẩm mẫu</p></div><span class="sub" id="total"></span></div><div class="search"><input id="query" placeholder="Tìm theo tên hoặc mã acc..." oninput="renderProducts()"><button class="btn mainbtn" onclick="renderProducts()">Tìm acc</button></div><div class="products" id="productsList"></div><div class="notice">Đây là giao diện demo. Sản phẩm và giá là dữ liệu mẫu; thanh toán và giao tài khoản chưa được kết nối.</div></section>
</main><footer><div class="wrap foot"><div><b style="color:white">VTACC.</b><br>SHOP TÀI KHOẢN GAME</div><div>Liên hệ hỗ trợ: cập nhật thông tin shop tại đây<br>© 2026 VTACC. All rights reserved.</div></div></footer>
<div class="modal" id="modal" onclick="if(event.target===this)closeModal()"><div class="box"><div class="mhead"><h2 id="modalTitle">Thông tin</h2><button class="close" onclick="closeModal()">×</button></div><div id="modalBody"></div></div></div>
<script>
const categories=[{id:"all",icon:"🎮",name:"Tất cả tài khoản",desc:"Xem toàn bộ acc"},{id:"lq",icon:"⚔️",name:"Liên Quân",desc:"Tài khoản Liên Quân"},{id:"ff",icon:"🔥",name:"Free Fire",desc:"Tài khoản Free Fire"},{id:"other",icon:"🎲",name:"Roblox / FC Mobile",desc:"Acc Roblox và FC Mobile"}];
const accounts=[
{id:"VT001",cat:"lq",name:"Acc Liên Quân cơ bản",price:50000,icon:"⚔️"},
{id:"VT002",cat:"lq",name:"Acc Liên Quân bộ sưu tập",price:120000,icon:"🛡️"},
{id:"VT003",cat:"ff",name:"Acc Free Fire cơ bản",price:45000,icon:"🔥"},
{id:"VT004",cat:"ff",name:"Acc Free Fire nâng cấp",price:150000,icon:"🎯"},
{id:"VT005",cat:"other",name:"Acc Roblox trải nghiệm",price:60000,icon:"🎲"},
{id:"VT006",cat:"other",name:"Acc FC Mobile mẫu",price:100000,icon:"⚽"}];
let active="all",cart=[];const money=n=>n.toLocaleString("vi-VN")+"đ";
function renderCats(){document.getElementById("cats").innerHTML=categories.map(c=>`<button class="cat ${active===c.id?"active":""}" onclick="choose('${c.id}')"><span>${c.icon}</span><b>${c.name}</b><small>${c.desc}</small></button>`).join("")}
function renderProducts(){let q=document.getElementById("query").value.toLowerCase();let list=accounts.filter(a=>(active==="all"||a.cat===active)&&(a.name.toLowerCase().includes(q)||a.id.toLowerCase().includes(q)));document.getElementById("heading").textContent=active==="all"?"Acc đang trưng bày":categories.find(c=>c.id===active).name;document.getElementById("total").textContent=list.length+" sản phẩm";document.getElementById("productsList").innerHTML=list.length?list.map(a=>`<article class="product"><div class="cover"><span class="status">ĐANG BÁN</span>${a.icon}</div><div class="info"><h3>${a.name}</h3><div class="meta"><span>Mã: ${a.id}</span><span>Còn hàng</span></div><div class="price">${money(a.price)}</div><div class="actions"><button class="detail" onclick="detail('${a.id}')">Chi tiết</button><button class="buy" onclick="add('${a.id}')">Mua ngay</button></div></div></article>`).join(""):'<div class="empty">Không tìm thấy tài khoản.</div>'}
function choose(id){active=id;renderCats();renderProducts()}
function detail(id){let a=accounts.find(x=>x.id===id);document.getElementById("modalTitle").textContent="Chi tiết tài khoản";document.getElementById("modalBody").innerHTML=`<div style="font-size:45px;text-align:center">${a.icon}</div><h3>${a.name}</h3><p>Mã tài khoản: ${a.id}</p><p>Thông tin mô tả mẫu. Bạn có thể thay nội dung sản phẩm trong phần dữ liệu của code.</p><div class="price">${money(a.price)}</div><button class="btn mainbtn" onclick="add('${a.id}');closeModal()">Thêm vào giỏ</button>`;openModal()}
function add(id){cart.push(accounts.find(a=>a.id===id));document.getElementById("count").textContent=cart.length;alert("Đã thêm sản phẩm vào giỏ hàng.")}
function showCart(){let total=cart.reduce((s,a)=>s+a.price,0);document.getElementById("modalTitle").textContent="Giỏ hàng";document.getElementById("modalBody").innerHTML=cart.length?cart.map((a,i)=>`<div class="cartrow"><span>${a.name}<br><b style="color:#ffcc65">${money(a.price)}</b></span><button class="btn" onclick="removeItem(${i})">Xóa</button></div>`).join("")+`<div class="price">Tổng: ${money(total)}</div><button class="btn mainbtn" onclick="alert('Bản demo chưa kết nối thanh toán.')">Tiếp tục</button>`:"<p>Giỏ hàng đang trống.</p>";openModal()}
function removeItem(i){cart.splice(i,1);document.getElementById("count").textContent=cart.length;showCart()}
function openModal(){document.getElementById("modal").classList.add("show")}function closeModal(){document.getElementById("modal").classList.remove("show")}
renderCats();renderProducts();
</script></body></html>
